{
  "name": "test_mysql_cdc_raw",
  "db": "MySQL",
  "type": "source",
  "format": "Avro",
  "description": "TEST SAMPLE (Docker sandbox). Debezium MySQL CDC with Confluent Avro converters and NO transform, so topics keep the full Debezium envelope (before / after / op / source). Compare against the unwrap variant to see what ExtractNewRecordState removes. Deploy via a Kafka Connect connection (REST).",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "tasks.max": "1",
    "database.hostname": "mysql",
    "database.port": "3306",
    "database.user": "root",
    "database.password": "debezium",
    "database.whitelist": "inventory",
    "table.whitelist": "inventory.customers",
    "database.history.kafka.bootstrap.servers": "kafka:9092",
    "database.server.id": "55003",
    "database.server.name": "sbconfraw",
    "database.history.kafka.topic": "sb-confraw-hist",
    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "key.converter.schema.registry.url": "http://schema-registry:8081",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081"
  }
}
