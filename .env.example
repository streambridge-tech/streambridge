# Optional. Use this only for fields you left blank in profile.yaml.
# A value already set in profile.yaml is kept. A variable already exported in the shell wins over this file.
#
# sqlite | postgresql | mysql
export STREAMBRIDGE__DATABASE__BACKEND=sqlite

# Used when backend is sqlite. Relative paths are from the project root.
export STREAMBRIDGE__DATABASE__SQLITE__PATH=data/streambridge.db

# Used when backend is mysql.
export STREAMBRIDGE__DATABASE__MYSQL__HOST=127.0.0.1
export STREAMBRIDGE__DATABASE__MYSQL__PORT=3306
export STREAMBRIDGE__DATABASE__MYSQL__DATABASE=streambridge
export STREAMBRIDGE__DATABASE__MYSQL__USERNAME=
export STREAMBRIDGE__DATABASE__MYSQL__PASSWORD=

# Used when backend is postgresql.
export STREAMBRIDGE__DATABASE__POSTGRESQL__HOST=127.0.0.1
export STREAMBRIDGE__DATABASE__POSTGRESQL__PORT=5432
export STREAMBRIDGE__DATABASE__POSTGRESQL__DATABASE=streambridge
export STREAMBRIDGE__DATABASE__POSTGRESQL__USERNAME=
export STREAMBRIDGE__DATABASE__POSTGRESQL__PASSWORD=
